# --- Backend configuration ---

# Secret key used to sign session tokens. Generate a strong random value in production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-long-random-string

# SQLite database location. In Docker/Cloud Run, point this at a writable path.
DATABASE_URL=sqlite:///./opportunxt.db

# Comma-separated list of allowed frontend origins, or "*" for the hackathon demo.
CORS_ORIGINS=*

# Port the server listens on (Cloud Run sets this automatically at runtime).
PORT=8080

# --- Frontend configuration ---
# Leave unset for production (same-origin requests to the FastAPI backend serving the build).
# During `npm run dev`, it defaults to http://localhost:8000 automatically.
# Set this only if your backend runs on a different host/port.
# VITE_API_URL=http://localhost:8000
